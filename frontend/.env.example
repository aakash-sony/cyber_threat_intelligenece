# Cyber Threat Intelligence SOC Dashboard - Frontend Environment Variables

# Backend Spring Boot API Base URL
VITE_API_BASE_URL=http://localhost:8080/api

# Google Analytics 4 (GA4) Web Stream Measurement ID
# Format: G-XXXXXXXXXX (starts with 'G-' followed by alphanumeric stream identifier)
# Obtain from: Google Analytics > Admin > Data Streams > Web > Measurement ID
# Leave blank or omit in development if analytics tracking is not desired.
VITE_GA4_MEASUREMENT_ID=
