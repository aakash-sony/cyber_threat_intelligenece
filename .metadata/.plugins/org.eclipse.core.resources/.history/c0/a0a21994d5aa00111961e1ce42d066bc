package com.cyberthreat.dashboard.util;

import lombok.AccessLevel;
import lombok.NoArgsConstructor;

import java.net.URI;
import java.util.regex.Pattern;

/**
 * Utility for threat indicator normalization and host extraction.
 *
 * NOTE: All fabricated country mappings (COMMON_COUNTRIES arrays, keyword matching,
 * and deterministic hashCode distribution) have been completely removed.
 * Authentic country metadata must be resolved via GeoLocationService.
 */
@NoArgsConstructor(access = AccessLevel.PRIVATE)
public final class GeoEnrichmentUtils {

    private static final Pattern IPV4_PATTERN = Pattern.compile(
            "^(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$"
    );

    /**
     * Fallback resolution method maintained for backward compatibility.
     * Never fabricates country names. Unresolved indicators return "Unknown".
     */
    public static String resolveCountry(final String indicator, final String target, final String source) {
        if (indicator == null || indicator.isBlank()) {
            return "Unknown";
        }
        // Genuine data resolution must be performed via GeoLocationService.
        // Fabricated country mapping has been permanently removed.
        return "Unknown";
    }

    /**
     * Extracts target hostname or IP address from a URL or raw indicator.
     */
    public static String extractHost(final String indicator) {
        if (indicator == null || indicator.isBlank()) return null;
        var text = indicator.trim();

        if (text.startsWith("http://") || text.startsWith("https://")) {
            try {
                final URI uri = URI.create(text);
                final String host = uri.getHost();
                if (host != null && !host.isBlank()) return host;
            } catch (final Exception ignored) {
                // fall through
            }
            text = text.replaceFirst("^https?://", "");
        }

        final int slashIdx = text.indexOf('/');
        if (slashIdx != -1) {
            text = text.substring(0, slashIdx);
        }
        final int colonIdx = text.indexOf(':');
        if (colonIdx != -1) {
            text = text.substring(0, colonIdx);
        }

        return text.isBlank() ? null : text;
    }

    /**
     * Checks if an indicator matches standard IPv4 syntax.
     */
    public static boolean isIpv4(final String indicator) {
        if (indicator == null || indicator.isBlank()) return false;
        return IPV4_PATTERN.matcher(indicator.trim()).matches();
    }
}
