    @Override
    @Transactional(readOnly = true)
    public List<String> getAvailableCountries() {
        List<String> countries = threatRepository.findDistinctCountries();
        if (!countries.contains("India")) {
            countries.add(0, "India");
        }
        return countries;
    }

    @Override
    @Transactional(readOnly = true)
    public List<Map<String, Object>> getCountryStats(String timeRange) {
        LocalDateTime startTime = parseStartTime(timeRange);
        List<Object[]> rows;
        if (startTime != null) {
            rows = threatRepository.countGroupedByCountrySince(startTime);
        } else {
            rows = threatRepository.countGroupedByCountry();
        }

        long total = 0;
        for (Object[] row : rows) {
            total += ((Number) row[1]).longValue();
        }

        List<Map<String, Object>> results = new ArrayList<>();
        for (Object[] row : rows) {
            String countryName = (String) row[0];
            long count = ((Number) row[1]).longValue();
            double percentage = total > 0 ? Math.round((count * 100.0 / total) * 10.0) / 10.0 : 0.0;

            Map<String, Object> entry = new LinkedHashMap<>();
            entry.put("country", countryName);
            entry.put("count", count);
            entry.put("percentage", percentage);
            results.add(entry);
        }
        return results;
    }

    @Override
    @Transactional(readOnly = true)
    public List<DetailedSourceResponse> getDetailedSources() {
        List<String> sources = threatRepository.findDistinctSources();
        List<DetailedSourceResponse> result = new ArrayList<>();

        Map<String, String> descMap = Map.of(
                "PhishTank", "Collaborative clearing house for verified phishing data.",
                "URLhaus", "Project from abuse.ch sharing malicious URLs used for malware distribution.",
                "OpenPhish", "Autonomous phishing threat intelligence feed detecting active attacks.",
                "I4C / NCRP", "National Cybercrime Reporting Portal under Ministry of Home Affairs, India.",
                "ThreatFox", "Free platform from abuse.ch for sharing Indicators of Compromise (IOCs).",
                "AlienVault OTX", "Global open threat intelligence community."
        );

        Map<String, String> statusMap = Map.of(
                "PhishTank", "ACTIVE",
                "URLhaus", "ACTIVE",
                "OpenPhish", "ACTIVE",
                "I4C / NCRP", "ACTIVE",
                "ThreatFox", "ACTIVE",
                "AlienVault OTX", "ACTIVE"
        );

        for (String source : sources) {
            long total = threatRepository.countGroupedBySource().stream()
                    .filter(r -> source.equals(r[0]))
                    .mapToLong(r -> ((Number) r[1]).longValue())
                    .findFirst()
                    .orElse(0L);

            LocalDateTime maxLastSeen = threatRepository.findMaxLastSeenBySource(source);

            result.add(DetailedSourceResponse.builder()
                    .name(source)
                    .status(statusMap.getOrDefault(source, "ACTIVE"))
                    .count(total)
                    .percentage(0.0)
                    .type("Verified Threat Intelligence Stream")
                    .url(ThreatUrlUtils.buildExactCaseUrl(source, "", IndicatorType.URL))
                    .color("#2563eb")
                    .lastDetected(maxLastSeen != null ? maxLastSeen : LocalDateTime.now())
                    .description(descMap.getOrDefault(source, "Connected Cyber Threat Intelligence stream."))
                    .build());
        }

        return result;
    }

    private String normalizeCountry(String country) {
        if (country == null || country.isBlank() || country.equalsIgnoreCase("all") || country.equalsIgnoreCase("all countries")) {
            return null;
        }
        return country.trim();
    }

    private LocalDateTime parseStartTime(String timeRange) {
        if (timeRange == null || timeRange.isBlank() || timeRange.equalsIgnoreCase("all")) {
            return null;
        }
        LocalDateTime now = LocalDateTime.now();
        switch (timeRange.toLowerCase().trim()) {
            case "7d":
            case "week":
                return now.minusDays(7);
            case "30d":
            case "1m":
            case "month":
                return now.minusDays(30);
            case "90d":
            case "3m":
                 return now.minusDays(90);
            case "24h":
            default:
                return now.minusHours(24);
        }
    }
