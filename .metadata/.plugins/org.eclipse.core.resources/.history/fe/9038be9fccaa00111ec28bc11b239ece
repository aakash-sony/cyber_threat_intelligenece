package com.cyberthreat.dashboard.service.impl;

import com.cyberthreat.dashboard.dto.request.ThreatCreateRequest;
import com.cyberthreat.dashboard.dto.response.SyncStatusResponse;
import com.cyberthreat.dashboard.repository.ThreatRepository;
import com.cyberthreat.dashboard.service.ThreatIntelligenceProvider;
import com.cyberthreat.dashboard.service.ThreatService;
import com.cyberthreat.dashboard.service.ThreatSyncService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;

import java.time.Duration;
import java.time.LocalDateTime;
import java.util.*;
import java.util.concurrent.atomic.AtomicBoolean;

@Slf4j
@Service
@RequiredArgsConstructor
public class ThreatSyncServiceImpl implements ThreatSyncService {

    private final List<ThreatIntelligenceProvider> providers;
    private final ThreatService threatService;
    private final ThreatRepository threatRepository;

    @Value("${threat.scheduler.fixed-rate-ms:900000}")
    private long fixedRateMs;

    private final AtomicBoolean isSyncRunning = new AtomicBoolean(false);
    private volatile LocalDateTime lastSyncTime = LocalDateTime.now().minusMinutes(5);
    private volatile LocalDateTime nextSyncTime = LocalDateTime.now().plusMinutes(10);
    private volatile String syncStatus = "SUCCESS";
    private volatile int lastRecordsIngested = 0;
    private volatile String lastSyncMessage = "System operational. Automated 15-minute background sync active.";
    private final Map<String, Integer> providerCounts = new HashMap<>();

    @Override
    public SyncStatusResponse getSyncStatus() {
        LocalDateTime now = LocalDateTime.now();
        int secondsRemaining = 0;
        if (nextSyncTime != null && nextSyncTime.isAfter(now)) {
            secondsRemaining = (int) Duration.between(now, nextSyncTime).getSeconds();
        }

        List<SyncStatusResponse.ProviderStatusItem> providerItems = new ArrayList<>();
        for (ThreatIntelligenceProvider provider : providers) {
            // Check if mock or live
            boolean isLive = provider.isLiveFeed();
            int count = providerCounts.getOrDefault(provider.getProviderName(), 0);
            String status = isLive ? "ONLINE" : "OFFLINE_FALLBACK";

            providerItems.add(SyncStatusResponse.ProviderStatusItem.builder()
                    .name(provider.getProviderName())
                    .isLive(isLive)
                    .status(status)
                    .lastBatchCount(count)
                    .feedUrl(provider.getFeedUrl())
                    .build());
        }

        return SyncStatusResponse.builder()
                .status(isSyncRunning.get() ? "RUNNING" : syncStatus)
                .lastSyncTime(lastSyncTime)
                .nextSyncTime(nextSyncTime)
                .secondsUntilNextSync(secondsRemaining)
                .lastRecordsIngested(lastRecordsIngested)
                 .lastRecordsUpdated(0)
                .totalThreatsInDb(threatRepository.count())
                .message(lastSyncMessage)
                .providers(providerItems)
                .build();
    }

    @Override
    public SyncStatusResponse triggerSync() {
        if (!isSyncRunning.compareAndSet(false, true)) {
            log.info("Threat intelligence synchronization is already in progress. Skipping concurrent execution.");
            return getSyncStatus();
        }

        LocalDateTime startTime = LocalDateTime.now();
        log.info("==== Starting automated 15-minute threat intelligence sync cycle at {} ====", startTime);
        int totalIngested = 0;
        int successfulProviders = 0;
        int failedProviders = 0;

        try {
            for (ThreatIntelligenceProvider provider : providers) {
                // We prefer live feeds, but if mock provider is present, we skip mock during scheduled sync unless all live feeds fail
                if (!provider.isLiveFeed()) {
                    continue;
                }

                String name = provider.getProviderName();
                try {
                    log.info("Polling live provider: {}", name);
                    List<ThreatCreateRequest> threats = provider.fetchThreats();
                    int providerCount = 0;

                    for (ThreatCreateRequest threat : threats) {
                        try {
                            threatService.createOrUpdateThreat(threat);
                            providerCount++;
                        } catch (Exception e) {
                            log.warn("Failed to persist indicator {} from {}: {}", threat.getIndicator(), name, e.getMessage());
                        }
                    }

                    providerCounts.put(name, providerCount);
                    totalIngested += providerCount;
                    successfulProviders++;
                    log.info("Provider {} finished: {} indicators normalized & upserted.", name, providerCount);
                } catch (Exception e) {
                    failedProviders++;
                    log.error("Provider {} encountered an unexpected ingestion error: {}", name, e.getMessage());
                    providerCounts.put(name, 0);
                }
            }

            lastSyncTime = LocalDateTime.now();
            long rateMinutes = Math.max(1, fixedRateMs / (60 * 1000));
            nextSyncTime = lastSyncTime.plusMinutes(rateMinutes);
            lastRecordsIngested = totalIngested;

            if (failedProviders == 0 && successfulProviders > 0) {
                syncStatus = "SUCCESS";
                lastSyncMessage = String.format("Auto-sync completed successfully. Ingested %d fresh threat records across %d live providers.", totalIngested, successfulProviders);
            } else if (successfulProviders > 0) {
                syncStatus = "PARTIAL";
                lastSyncMessage = String.format("Auto-sync completed with warnings. Ingested %d records (%d succeeded, %d failed).", totalIngested, successfulProviders, failedProviders);
            } else {
                syncStatus = "FAILED";
                lastSyncMessage = "External threat APIs were unreachable or returned empty payloads. Existing database records preserved.";
            }

            log.info("==== Threat sync cycle completed. Ingested: {}, Status: {} ====", totalIngested, syncStatus);
        } catch (Exception e) {
            log.error("Fatal exception during threat intelligence sync: {}", e.getMessage(), e);
            syncStatus = "FAILED";
            lastSyncMessage = "Ingestion error: " + e.getMessage();
        } finally {
            isSyncRunning.set(false);
        }

        return getSyncStatus();
    }
}
