	@Override
	@Transactional(readOnly = true)
	public List<Map<String, Object>> getCountryStats(final String timeRange) {
		final var startTime = parseStartTime(timeRange);
		List<Object[]> rows;
		if (startTime != null)
			rows = threatRepository.countGroupedByCountrySince(startTime);
		else
			rows = threatRepository.countGroupedByCountry();

		var total = 0L;
		for (final Object[] row : rows)
			total += ((Number) row[1]).longValue();

		final List<Map<String, Object>> results = new ArrayList<>();
		for (final Object[] row : rows) {
			final var countryName = (String) row[0];
			final var count = ((Number) row[1]).longValue();
			final var percentage = total > 0 ? Math.round(count * 100.0 / total * 10.0) / 10.0 : 0.0;

			final Map<String, Object> entry = new LinkedHashMap<>();
			entry.put("country", countryName);
			entry.put("count", count);
			entry.put("percentage", percentage);
			results.add(entry);
		}
		return results;
	}

	@Override
	@Transactional(readOnly = true)
	public List<DetailedSourceResponse> getDetailedSources() {
		final var sources = threatRepository.findDistinctSources();
		final List<DetailedSourceResponse> result = new ArrayList<>();

		final Map<String, String> descMap = Map.of(
				"PhishTank", "Collaborative clearing house for verified phishing data.",
				"URLhaus", "Project from abuse.ch sharing malicious URLs used for malware distribution.",
				"OpenPhish", "Autonomous phishing threat intelligence feed detecting active attacks.",
				"I4C / NCRP", "National Cybercrime Reporting Portal under Ministry of Home Affairs, India.",
				"ThreatFox", "Free platform from abuse.ch for sharing Indicators of Compromise (IOCs).",
				"AlienVault OTX", "Global open threat intelligence community."
				);

		final Map<String, String> statusMap = Map.of(
				"PhishTank", "ACTIVE",
				"URLhaus", "ACTIVE",
				"OpenPhish", "ACTIVE",
				"I4C / NCRP", "ACTIVE",
				"ThreatFox", "ACTIVE",
				"AlienVault OTX", "ACTIVE"
				);

		for (final String source : sources) {
			final var total = threatRepository.countGroupedBySource().stream()
					.filter(r -> source.equals(r[0]))
					.mapToLong(r -> ((Number) r[1]).longValue())
					.findFirst()
					.orElse(0L);

			final var maxLastSeen = threatRepository.findMaxLastSeenBySource(source);

			result.add(DetailedSourceResponse.builder()
					.name(source)
					.status(statusMap.getOrDefault(source, "ACTIVE"))
					.count(total)
					.percentage(0.0)
					.type("Verified Threat Intelligence Stream")
					.url(ThreatUrlUtils.buildInvestigationUrl(source, "", IndicatorType.URL))
					.color("#2563eb")
					.lastDetected(maxLastSeen != null ? maxLastSeen : LocalDateTime.now())
					.description(descMap.getOrDefault(source, "Connected Cyber Threat Intelligence stream."))
					.build());
		}

		return result;
	}

	private String normalizeCountry(final String country) {
		if (country == null || country.isBlank() || "all".equalsIgnoreCase(country) || "all countries".equalsIgnoreCase(country))
			return null;
		return country.trim();
	}

	private LocalDateTime parseStartTime(final String timeRange) {
		if (timeRange == null || timeRange.isBlank() || "all".equalsIgnoreCase(timeRange))
			return null;
		final var now = LocalDateTime.now();
		return switch (timeRange.toLowerCase().trim()) {
		case "7d", "week" -> now.minusDays(7);
		case "30d", "1m", "month" -> now.minusDays(30);
		case "90d", "3m", "3 months" -> now.minusDays(90);
		case "24h" -> now.minusHours(24);
		default -> now.minusDays(90);
		};
	}
