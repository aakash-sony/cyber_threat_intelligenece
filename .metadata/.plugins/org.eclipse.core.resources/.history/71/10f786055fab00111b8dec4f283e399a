package com.cyberthreat.dashboard.repository;

import java.time.LocalDateTime;
import java.util.Collection;
import java.util.List;
import java.util.Optional;

import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.JpaSpecificationExecutor;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;
import org.springframework.stereotype.Repository;

import com.cyberthreat.dashboard.entity.ThreatEntity;
import com.cyberthreat.dashboard.enums.IndicatorType;
import com.cyberthreat.dashboard.enums.Severity;

@Repository
public interface ThreatRepository extends JpaRepository<ThreatEntity, Long>, JpaSpecificationExecutor<ThreatEntity> {

	Optional<ThreatEntity> findByIndicatorAndIndicatorTypeAndSource(String indicator, IndicatorType indicatorType, String source);

	@Query("SELECT t FROM ThreatEntity t WHERE t.source = :source AND t.indicator IN :indicators")
	List<ThreatEntity> findBySourceAndIndicatorIn(@Param("source") String source, @Param("indicators") Collection<String> indicators);

	Page<ThreatEntity> findBySeverity(Severity severity, Pageable pageable);
	
	@Query("""
			SELECT
				COUNT(t),
				COUNT(CASE WHEN t.severity 		= Severity.CRITICAL THEN 1 END),
				COUNT(CASE WHEN t.severity 		= Severity.HIGH THEN 1 END),
				COUNT(CASE WHEN t.severity 		= Severity.MEDIUM THEN 1 END),
				COUNT(CASE WHEN t.severity 		= Severity.LOW THEN 1 END),
				COUNT(CASE WHEN t.status 		= ThreatStatus.ACTIVE THEN 1 END),
				COUNT(CASE WHEN t.threatType 	= PHISHING THEN 1 END),
				COUNT(CASE WHEN t.threatType 	= MALWARE THEN 1 END),
				COUNT(CASE WHEN t.threatType 	= ThreatType.FRAUD THEN 1 END),
				COUNT(CASE WHEN t.indicatorType = IndicatorType.URL THEN 1 END),
				COUNT(CASE WHEN t.indicatorType = IndicatorType.IP THEN 1 END),
				COUNT(CASE WHEN t.indicatorType = IndicatorType.DOMAIN THEN 1 END),
				COUNT(CASE WHEN t.indicatorType = IndicatorType.HASH THEN 1 END)
			FROM ThreatEntity t
			WHERE (:startTime IS NULL OR COALESCE(t.lastSeen, t.createdAt) >= :startTime)
			  AND (:country IS NULL OR LOWER(t.country) = LOWER(:country))
			""")
	List<Object[]> getDashboardSummaryMetrics(@Param("country") String country, @Param("startTime") LocalDateTime startTime);

	
	@Query("SELECT t.source, COUNT(t) FROM ThreatEntity t GROUP BY t.source ORDER BY COUNT(t) DESC")
	List<Object[]> countGroupedBySource();

	@Query("SELECT t.severity, COUNT(t) FROM ThreatEntity t GROUP BY t.severity")
	List<Object[]> countGroupedBySeverity();

	@Query("SELECT t.threatType, COUNT(t) FROM ThreatEntity t GROUP BY t.threatType ORDER BY COUNT(t) DESC")
	List<Object[]> countGroupedByThreatType();

	@Query("SELECT t.country, COUNT(t) FROM ThreatEntity t WHERE t.country IS NOT NULL GROUP BY t.country ORDER BY COUNT(t) DESC")
	List<Object[]> countGroupedByCountry();

	@Query("SELECT t.source, COUNT(t) FROM ThreatEntity t WHERE COALESCE(t.lastSeen, t.createdAt) >= :startTime GROUP BY t.source ORDER BY COUNT(t) DESC")
	List<Object[]> countGroupedBySourceSince(@Param("startTime") LocalDateTime startTime);

	@Query("SELECT t.severity, COUNT(t) FROM ThreatEntity t WHERE COALESCE(t.lastSeen, t.createdAt) >= :startTime GROUP BY t.severity")
	List<Object[]> countGroupedBySeveritySince(@Param("startTime") LocalDateTime startTime);

	@Query("SELECT t.threatType, COUNT(t) FROM ThreatEntity t WHERE COALESCE(t.lastSeen, t.createdAt) >= :startTime GROUP BY t.threatType ORDER BY COUNT(t) DESC")
	List<Object[]> countGroupedByThreatTypeSince(@Param("startTime") LocalDateTime startTime);

	@Query("SELECT DISTINCT t.source FROM ThreatEntity t WHERE t.source IS NOT NULL ORDER BY t.source ASC")
	List<String> findDistinctSources();

	@Query("SELECT DISTINCT t.country FROM ThreatEntity t WHERE t.country IS NOT NULL AND t.country != '' AND LOWER(t.country) != 'unknown' AND LOWER(t.country) != 'global' ORDER BY t.country ASC")
	List<String> findDistinctCountries();

	@Query("SELECT MIN(t.lastSeen) FROM ThreatEntity t")
	LocalDateTime findMinLastSeen();

	@Query("SELECT MIN(t.lastSeen) FROM ThreatEntity t WHERE LOWER(t.country) = :country")
	LocalDateTime findMinLastSeenWithCountry(@Param("country") String country);

	@Query("SELECT MIN(t.createdAt) FROM ThreatEntity t")
	LocalDateTime findMinCreatedAt();

	@Query("SELECT MIN(t.createdAt) FROM ThreatEntity t WHERE LOWER(t.country) = :country")
	LocalDateTime findMinCreatedAtWithCountry(@Param("country") String country);

	@Query("SELECT MAX(t.lastSeen) FROM ThreatEntity t WHERE t.source = :source")
	LocalDateTime findMaxLastSeenBySource(@Param("source") String source);

	@Query("SELECT t.source, MAX(t.lastSeen) FROM ThreatEntity t GROUP BY t.source")
	List<Object[]> findMaxLastSeenGroupedBySource();

	@Query("SELECT t.source, COUNT(t) FROM ThreatEntity t WHERE COALESCE(t.lastSeen, t.createdAt) >= :startTime AND LOWER(t.country) = :country GROUP BY t.source ORDER BY COUNT(t) DESC")
	List<Object[]> countGroupedBySourceWithCountryAndSince(@Param("country") String country, @Param("startTime") LocalDateTime startTime);

	@Query("SELECT t.source, COUNT(t) FROM ThreatEntity t WHERE LOWER(t.country) = :country GROUP BY t.source ORDER BY COUNT(t) DESC")
	List<Object[]> countGroupedBySourceWithCountry(@Param("country") String country);

	@Query("SELECT t.severity, COUNT(t) FROM ThreatEntity t WHERE COALESCE(t.lastSeen, t.createdAt) >= :startTime AND LOWER(t.country) = :country GROUP BY t.severity")
	List<Object[]> countGroupedBySeverityWithCountryAndSince(@Param("country") String country, @Param("startTime") LocalDateTime startTime);

	@Query("SELECT t.severity, COUNT(t) FROM ThreatEntity t WHERE LOWER(t.country) = :country GROUP BY t.severity")
	List<Object[]> countGroupedBySeverityWithCountry(@Param("country") String country);

	@Query("SELECT t.threatType, COUNT(t) FROM ThreatEntity t WHERE COALESCE(t.lastSeen, t.createdAt) >= :startTime AND LOWER(t.country) = :country GROUP BY t.threatType ORDER BY COUNT(t) DESC")
	List<Object[]> countGroupedByThreatTypeWithCountryAndSince(@Param("country") String country, @Param("startTime") LocalDateTime startTime);

	@Query("SELECT t.threatType, COUNT(t) FROM ThreatEntity t WHERE LOWER(t.country) = :country GROUP BY t.threatType ORDER BY COUNT(t) DESC")
	List<Object[]> countGroupedByThreatTypeWithCountry(@Param("country") String country);

	@Query("SELECT t.country, COUNT(t) FROM ThreatEntity t WHERE t.country IS NOT NULL AND t.country != '' AND COALESCE(t.lastSeen, t.createdAt) >= :startTime GROUP BY t.country ORDER BY COUNT(t) DESC")
	List<Object[]> countGroupedByCountrySince(@Param("startTime") LocalDateTime startTime);

	@Query("""
			SELECT
				COUNT(t),
				COUNT(CASE WHEN t.threatType = com.cyberthreat.dashboard.enums.ThreatType.PHISHING THEN 1 END),
				COUNT(CASE WHEN t.threatType = com.cyberthreat.dashboard.enums.ThreatType.MALWARE THEN 1 END),
				COUNT(CASE WHEN t.threatType = com.cyberthreat.dashboard.enums.ThreatType.FRAUD THEN 1 END)
			FROM ThreatEntity t
			WHERE COALESCE(t.lastSeen, t.createdAt) >= :startOfDay
			  AND (:country IS NULL OR LOWER(t.country) = LOWER(:country))
			""")
	List<Object[]> getTodayIncrements(@Param("country") String country, @Param("startOfDay") LocalDateTime startOfDay);
}
