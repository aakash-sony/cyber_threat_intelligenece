package com.cyberthreat.dashboard.service.impl;

import com.cyberthreat.dashboard.dto.response.SyncStatusResponse;
import com.cyberthreat.dashboard.repository.ThreatRepository;
import com.cyberthreat.dashboard.service.ThreatSyncService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.boot.CommandLineRunner;
import org.springframework.stereotype.Component;

@Slf4j
@Component
@RequiredArgsConstructor
public class DataSeederService implements CommandLineRunner {

    private final ThreatRepository threatRepository;
    private final ThreatSyncService threatSyncService;

    @Override
    public void run(String... args) {
        long count = threatRepository.count();
        log.info("Inspecting PostgreSQL database state. Current threat count: {}", count);

        if (count == 0) {
            log.info("Database is empty. Initiating initial live threat data ingestion from public feeds...");
            SyncStatusResponse status = threatSyncService.triggerSync();
             log.info("Initial live threat ingestion completed. Status: {}, Ingested: {} records. Total in DB: {}",
                    status.getStatus(), status.getLastRecordsIngested(), status.getTotalThreatsInDb());
        } else {
            log.info("Database already populated with {} threat records. Automated 15-minute scheduler active for incremental updates.", count);
        }
    }
}
